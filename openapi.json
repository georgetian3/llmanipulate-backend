                "type": "null"
              }
            ]
          },
          "components": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SingleChoice"
                },
                {
                  "$ref": "#/components/schemas/MultiChoice"
                },
                {
                  "$ref": "#/components/schemas/Slider"
