  "components": {
    "schemas": {
      "AgentConfig": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Similar to component ID, must be unique within this task, used to correlate chat messages with the agent that produced it."
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "The name that will be displayed in chat, leave empty to make the agent look like a human user"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name",
            "default": ""
          },
          "endpoint": {
            "type": "string",
            "title": "Endpoint",
            "default": ""
          },
          "api_key": {
            "type": "string",
            "title": "Api Key",
            "default": ""
          },
          "attributes": {
            "type": "object",
            "title": "Attributes",
            "default": {}
          },
          "base_prompt": {
            "type": "string",
            "title": "Base Prompt",
            "default": ""
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "title": "AgentConfig"
      },
      "ChatConfig": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "An ID unique within this task, used to correlate a component with its response"
          },
          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Translations"
              },
              {
                "type": "null"
              }
            ]
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "type": {
            "type": "string",
            "const": "chat",
            "title": "Type",
            "default": "chat"
          },
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentConfig"
            },
            "type": "array",
            "title": "Agents",
            "default": []
          },
          "order": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string",
                      "const": "human"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order",
            "description": "Order of conversation, required if any agents are participating in the chat. Elements of this list are either an integer indicating the index (starting from 0) of the agent in the list `agents`, or the string 'human' to indicate a human's turn",
            "default": []
          },
          "min_messages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Min Messages",
            "default": 0
          },
          "max_messages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Max Messages",
            "default": 99999
          },
          "humans_required": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Humans Required",
            "description": "Number of humans per chat, leave None for no limit"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ChatConfig"
      },
      "ComponentGroup-Input": {
        "properties": {
          "columns": {
            "type": "integer",
            "title": "Columns",
            "description": "The number of columns used to display the children of this component",
            "default": 1
          },
          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Translations"
              },
              {
                "type": "null"
              }
            ]
          },
          "components": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SingleChoice"
                },
                {
                  "$ref": "#/components/schemas/MultiChoice"
                },
                {
                  "$ref": "#/components/schemas/Slider"
                },
                {
                  "$ref": "#/components/schemas/FreeText"
                },
                {
                  "$ref": "#/components/schemas/ChatConfig"
                }
              ]
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "components"
        ],
        "title": "ComponentGroup"
      },
      "ComponentGroup-Output": {
        "properties": {
          "columns": {
            "type": "integer",
            "title": "Columns",
            "description": "The number of columns used to display the children of this component",
            "default": 1
          },
          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Translations"
              },
              {
                "type": "null"
              }
            ]
          },
          "components": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SingleChoice"
                },
                {
                  "$ref": "#/components/schemas/MultiChoice"
                },
                {
                  "$ref": "#/components/schemas/Slider"
                },
                {
                  "$ref": "#/components/schemas/FreeText"
                },
                {
                  "$ref": "#/components/schemas/ChatConfig"
                }
              ]
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "components"
        ],
        "title": "ComponentGroup"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "FreeText": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "An ID unique within this task, used to correlate a component with its response"
          },
          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Translations"
              },
              {
                "type": "null"
              }
            ]
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "type": {
            "type": "string",
            "const": "free_text",
            "title": "Type",
            "default": "free_text"
          },
          "regex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regex",
            "description": "The regular expression pattern that the user's input must match. `null` performs no matching."
          },
          "regex_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regex Prompt",
            "description": "Prompt to be shown if the regex does not match"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "FreeText"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequired": {
        "properties": {
          "login_required": {
            "type": "boolean",
            "title": "Login Required"
          }
        },
        "type": "object",
        "required": [
          "login_required"
        ],
        "title": "LoginRequired"
      },
      "MultiChoice": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "An ID unique within this task, used to correlate a component with its response"
          },
          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Translations"
              },
              {
                "type": "null"
              }
            ]
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/Translations"
            },
            "type": "array",
            "title": "Choices"
          },
          "shuffle": {
            "type": "boolean",
            "title": "Shuffle",
            "description": "If `true`, choices are displayed in a random order to the user",
            "default": false
          },
          "type": {
            "type": "string",
            "const": "multi_choice",
            "title": "Type",
            "default": "multi_choice"
          },
          "min_choices": {
            "type": "integer",
