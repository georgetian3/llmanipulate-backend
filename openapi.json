  "components": {
    "schemas": {
      "Agent": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid4",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "const": "agent",
            "title": "Type",
            "default": "agent"
          },
          "endpoint": {
            "type": "string",
            "title": "Endpoint"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "endpoint",
          "api_key",
          "prompt"
        ],
        "title": "Agent"
      },
      "Chat": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Id"
          },
          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Translations"
              },
              {
                "type": "null"
              }
            ]
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "type": {
            "type": "string",
            "const": "chat",
            "title": "Type",
            "default": "chat"
          },
          "agents": {
            "items": {
              "$ref": "#/components/schemas/Agent"
            },
            "type": "array",
            "title": "Agents",
            "default": []
          },
          "order": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uuid4"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order",
            "default": []
          },
          "all_users": {
            "type": "boolean",
            "title": "All Users"
          },
          "min_messages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Min Messages",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "all_users"
        ],
        "title": "Chat"
      },
      "ChatHistoryRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid4",
            "title": "Id"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageRead"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "id",
          "messages"
        ],
        "title": "ChatHistoryRead"
      },
      "ChatMessageRead": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "id": {
            "type": "string",
            "format": "uuid4",
            "title": "Id"
          },
          "chat": {
            "type": "string",
            "format": "uuid4",
            "title": "Chat"
          },
          "sender": {
            "type": "string",
            "format": "uuid4",
            "title": "Sender"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "message",
          "id",
          "chat",
          "sender",
          "timestamp"
        ],
        "title": "ChatMessageRead"
      },
      "ComponentGroup-Input": {
        "properties": {
