          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Translations"
              },
              {
                "type": "null"
              }
            ]
          },
          "components": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SingleChoice"
