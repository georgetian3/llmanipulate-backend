                {
                  "$ref": "#/components/schemas/MultiChoice"
                },
                {
                  "$ref": "#/components/schemas/Slider"
                },
                {
                  "$ref": "#/components/schemas/FreeText"
                },
                {
                  "$ref": "#/components/schemas/Chat"
                }
              ]
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "components"
        ],
        "title": "ComponentGroup"
      },
